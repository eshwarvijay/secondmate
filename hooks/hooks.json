{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/bin/session-holds.sh\"",
            "timeout": 10,
            "statusMessage": "secondmate: checking open decisions..."
          }
        ]
      }
    ]
  }
}
